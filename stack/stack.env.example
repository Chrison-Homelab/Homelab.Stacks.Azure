# Template for stack.env. Copy to `stack.env` and fill in, or let bin/deploy.ps1
# write it onto the LXC. The real file is gitignored — the connector token is
# sensitive (anyone with it can impersonate the tunnel against Cloudflare).

# Cloudflare connector token. Identifies the cloudflared container to the edge.
# Generated/refreshed by bin/provision.ps1.
TUNNEL_TOKEN=

# Image tags. Host and portal are versioned INDEPENDENTLY and their minor lines have
# diverged (host v1.10.x, portal v1.11.x) — do not assume they match. The tag suffix has
# also changed over releases (-beta -> -preview -> none), and the portal's GitHub release
# tags do not exist as image tags at all, so check Docker Hub before bumping either.
#
# THESE OVERRIDE the compose defaults. build/Build.cs is the source that writes this file,
# so a bump has to change all three or the next `Up` puts the old tags back.
TOPAZ_VERSION=v1.10.222-preview
PORTAL_VERSION=v1.11.19

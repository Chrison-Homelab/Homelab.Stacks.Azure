<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Topaz pulls everything (including Fallout.* — the hard-fork successor to
      NUKE) from nuget.org. No GitHub Packages feed is needed here, so no token
      is required to restore. See ADR-0021 in the ERP repo for the Fallout move.
    -->
  </packageSources>
</configuration>
